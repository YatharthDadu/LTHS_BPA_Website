{\fs20\f1\cf0   1 \line   2 import java.util.*;\line   3 import java.io.*;\line   4 import java.util.Locale;\line   5 \line   6 \line   7 public class CryptoExchangePortfolioManager\line   8 \'7b\line   9 \line  10  //GIVEN\line  11    public static void main (String args [])\line  12    \'7b\line  13       \line  14    \line  15       BufferedReader coinsIO = getReader("Coins.txt");   \line  16       List<ExchangeWrapper> cryptoPortfolio = new ArrayList<>();  //Contains the customer objects\line  17       ExchangeWrapper wrappedPosition = readCoinTextFiles(coinsIO);\line  18       cryptoPortfolio.add(wrappedPosition);\line  19       System.out.println("=========POSITIONS=========");\line  20       while (wrappedPosition != null)  \line  21       \'7b\line  22          wrappedPosition = readCoinTextFiles(coinsIO);\line  23          if(wrappedPosition != null)\line  24             cryptoPortfolio.add(wrappedPosition);\line  25       \'7d\line  26       for (ExchangeWrapper c : cryptoPortfolio)\'7b\line  27          System.out.println(c.getInfo()); \line  28       \'7d\line  29    \line  30       \line  31    \'7d\line  32    \line  33    //!!STUDENT WILL MAKE THIS  <===================================== \line  34    /*Reads the information from the file and breaks it into each of the \line  35    objects that go into the ExchangeWrapper object*/            \line  36    private static ExchangeWrapper readCoinTextFiles(BufferedReader coinsIO)   \line  37    \'7b\line  38       //Positions Class plus Fields\line  39       Positions pos; \line  40       String type;\line  41       String name;\line  42       String symbol;\line  43       double quantity;\line  44       double currentPrice;\line  45       double avgCost;\line  46       double buyPrice;\line  47       BlockInfo blkInfo;\line  48                \line  49       String line = "";\line  50       String[] data;  \line  51        \line  52       \line  53       //catches errors in the read\line  54       try\line  55       \'7b\line  56          line = coinsIO.readLine();\line  57       \'7d\line  58       catch (IOException e)\line  59       \'7b\line  60          System.out.println("I/O Error Coins");\line  61          System.exit(0);\line  62       \'7d\line  63       //ends the read once it gets to the end\line  64       if (line == null)\line  65          return null;\line  66       else\line  67       \'7b\line  68          data = line.split(";");  //";" is the delimiter to seperate the fields for the records\line  69          type = data[0];\line  70          name = data[1];    //each field goes in escalating arithmetic sequence 0 to 6\line  71          symbol = data[2];\line  72          quantity = Double.parseDouble(data[3]);\line  73          currentPrice = Double.parseDouble(data[4]);\line  74          avgCost = Double.parseDouble(data[5]);\line  75          buyPrice = Double.parseDouble(data[6]);\line  76          \line  77          /*Construct the objects to be placed in the Positions object; \line  78          the symbol will need to be trimmed */\line  79          String temp = symbol+".txt";\line  80          temp = temp.trim();\line  81          \line  82          //Read the Block Files to be constructed and added to the Positions\line  83          BufferedReader block = getReader(temp);\line  84          blkInfo = readBlockTextFiles(block);\line  85          \line  86          pos = new Positions(type.trim(), name.trim(), symbol.trim(), quantity, \line  87                               currentPrice, avgCost, buyPrice, blkInfo);\line  88          return new ExchangeWrapper(pos);\line  89       \'7d\line  90    \'7d\line  91    \line  92    //!!STUDENT WILL MAKE THIS  <=====================================\line  93    /*Reads the information from the file and breaks it into each of the objects that \line  94    go into the Positions object */\line  95    private static BlockInfo readBlockTextFiles(BufferedReader blockIO)  \line  96    \'7b\line  97       //Positions Class plus Fields\line  98       //The long value will need to be trimmed \line  99       BlockInfo blkInfo; \line 100       String web;\line 101       String source;\line 102       String trimHold;\line 103       long market;\line 104       String tag;\line 105    \line 106       String line = "";\line 107       String[] data;  \line 108        \line 109       \line 110       //catches errors in the read\line 111       try\line 112       \'7b\line 113          line = blockIO.readLine();\line 114       \'7d\line 115       catch (IOException e)\line 116       \'7b\line 117          System.out.println("I/O Error Block");\line 118          System.exit(0);\line 119       \'7d\line 120       //ends the read once it gets to the end\line 121       if (line == null)\line 122          return null;\line 123       else\line 124       \'7b\line 125          data = line.split(";");  //"," is the delimeter to seperate the fields for the records\line 126          web = data[0];\line 127          source = data[1];    //each field goes in escalating arithmetic sequence 0 to 3\line 128          trimHold = data[2];\line 129          market = Long.parseLong(trimHold.trim());\line 130          tag = data[3];   \line 131          \line 132          blkInfo = new BlockInfo(web, source, market, tag);\line 133          return blkInfo;\line 134       \'7d\line 135    \'7d\line 136 \line 137    //!!STUDENT WILL MAKE THIS  <=====================================\line 138    //imports the file properly for BufferedReader for reading all .txt files\line 139    private static BufferedReader getReader(String name)  \line 140    \'7b\line 141       BufferedReader coinsIO = null;\line 142       try\line 143       \'7b\line 144          File file = new File(name);\line 145          coinsIO = new BufferedReader(\line 146             new FileReader(file) );\line 147       \'7d\line 148       catch (FileNotFoundException e)\line 149       \'7b\line 150          System.out.println(\line 151             "The file doesn't exist.");\line 152          System.exit(0);\line 153       \'7d\line 154       \line 155    \line 156       return coinsIO;\line 157    \'7d\line 158 \'7d\line 159    \line 160    \line 161 \line 162 \line 163 \line 164 ////// ExchangeWrapper Information: GIVEN\line 165 class ExchangeWrapper\line 166 \'7b\line 167    public Positions positions;  \line 168 \line 169    \line 170    public ExchangeWrapper(Positions p)    \line 171    \'7b\line 172       this.positions = p;\line 173          \line 174    \'7d\line 175    \line 176    public String getInfo()\'7b\line 177    \line 178       return this.positions.getInfo();\line 179    \'7d\line 180 \'7d\line 181 \line 182 ////// Positions: Partially Given \line 183 class Positions\line 184 \'7b\line 185    private String type; //This is not used\line 186    private String name;\line 187    private String symbol;\line 188    private double quantity;\line 189    private double currentPrice;\line 190    private double avgCost;\line 191    private double buyPrice;\line 192    public BlockInfo blkInfo;  \line 193    private double percentChange;\line 194    \line 195    \line 196    //GIVEN\line 197    public Positions(String t, String n, String s, double q, double cp, double ac, \line 198                      double bp, BlockInfo bi)\line 199    \'7b\line 200       type = t;\line 201       name = n;\line 202       symbol = s;\line 203       quantity = q;\line 204       currentPrice = cp;\line 205       avgCost = ac;\line 206       buyPrice = bp;\line 207       blkInfo = bi;\line 208    \'7d\line 209   \line 210    //!!STUDENT WILL MAKE THIS  <=====================================\line 211    public String getInfo()\line 212    \'7b\line 213       return "\'5cnName: " + name + " | Symbol: " + symbol + " | Quantity: " + String.format("%,.4f",quantity) + \line 214             "| Current Price: $" + String.format("%,.4f",currentPrice) + "\'5cn\'5ctAverage Price $" + \line 215             String.format("%,.4f",avgCost) + " | Purchase Price: $" + String.format("%,.4f",buyPrice) + \line 216              " | Percent Change: " + percentChange() + "% \'5cn\'5ct" + blkInfo.getInfo();\line 217    \'7d\line 218    \line 219    //!!STUDENT WILL MAKE THIS  <===================================== \line 220    private String percentChange()\'7b\line 221       percentChange = ((currentPrice - buyPrice)/buyPrice) *100;\line 222       String temp = String.format("%,.2f",percentChange);\line 223       return temp;\line 224    \'7d\line 225 \'7d\line 226 \line 227 ////// BlockInfo: Partially Given\line 228 class BlockInfo\line 229 \'7b\line 230    private String website;\line 231    private String sourceCode;\line 232    private long marketCap;\line 233    private String tag;\line 234    \line 235    public BlockInfo(String w, String sc, long mc,  String t)\line 236    \'7b\line 237       website = w;\line 238       sourceCode = sc;\line 239       marketCap = mc;\line 240       tag = t;\line 241    \'7d\line 242    \line 243    //!!STUDENT WILL MAKE THIS  <===================================== \line 244    public String getInfo()\line 245    \'7b\line 246       return "Web URL: " + website + " | SourceCode URL: " + sourceCode + \line 247       " | Market Cap: $" + String.format("%,d", marketCap) + " | Tag: " + tag;\line 248    \'7d     \line 249 \line 250 \'7d\line 251 }}