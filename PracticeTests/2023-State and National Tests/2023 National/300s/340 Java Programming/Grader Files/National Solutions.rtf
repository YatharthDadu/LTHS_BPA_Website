{\fs20\f1\cf0   1 \line   2 \line   3 import java.util.*;\line   4 import java.text.NumberFormat;\line   5 import java.io.*;\line   6 \line   7 \line   8 public class CrytoProjectTransfer\line   9 \'7b\line  10  \line  11    public static void main (String args [])\line  12    \'7b\line  13    \line  14       //All three instances of RecordReader below reference the same wrapper object\line  15       MyWrapper wrp  = new MyWrapper(); \line  16          \line  17       //This is one of the easiest tactics and most probable, but not the only way\line  18       RecordReader rC = new RecordReader(wrp, "Coins.txt"); \line  19       RecordReader rT = new RecordReader(wrp,"Tokens.txt"); \line  20       RecordReader rN = new RecordReader(wrp,"NFT.txt" );\line  21    \line  22       //This is one of the easiest tactics and most probable, but not the only way\line  23       //It allows all of the data to get read off of the three text files and \line  24       //consolodated into the wrapper arraylist.\line  25       rC.inputFileReader();\line  26       rT.inputFileReader();\line  27       rN.inputFileReader();\line  28       \line  29       wrp.fileWriter();\line  30    \'7d\line  31 \'7d\line  32 \line  33 //////Assett Objects Information\line  34 //!!STUDENT WILL MAKE THIS  <===\line  35 class InvestmentProducts implements Assett_Interface \line  36 \'7b\line  37   \line  38    private String type;\line  39    private String name;\line  40    private String symbol;\line  41    private double quantity;\line  42    private double currentPrice;\line  43    private double avgPrice;\line  44    private double buyPrice;\line  45      \line  46   //1st Constructor that takes in the type of investment symbol. We don't use this in the file output \line  47    public InvestmentProducts(String type, String name, String symbol, double quantity, double currentPrice,\line  48                                double avgPrice, double buyPrice)\line  49    \'7b\line  50       this.type = type;\line  51       this.name=name;\line  52       this.symbol=symbol;\line  53       this.quantity=quantity;\line  54       this.currentPrice=currentPrice;\line  55       this.avgPrice=avgPrice;\line  56       this.buyPrice=buyPrice;\line  57    \'7d\line  58       \line  59   //2nd Constructor that ignores the type of investment symbol. We use this in the program\line  60    public InvestmentProducts(String name, String symbol, double quantity, double currentPrice,\line  61                                double avgPrice, double buyPrice)\line  62    \'7b\line  63       this.type = "";\line  64       this.name=name;\line  65       this.symbol=symbol;\line  66       this.quantity=quantity;\line  67       this.currentPrice=currentPrice;\line  68       this.avgPrice=avgPrice;\line  69       this.buyPrice=buyPrice;\line  70    \'7d\line  71 \line  72  //Required Get and Set functions per the interface implementation requirements\line  73  //Set functions will not be used in the file output.      \line  74    public String getType()\line  75    \'7b\line  76       return type;\line  77    \'7d\line  78    public void setType(String t)\line  79    \'7b\line  80       type = t;\line  81    \'7d\line  82    public String getName()\line  83    \'7b\line  84       return name;\line  85    \'7d\line  86    public void setName(String n)\line  87    \'7b\line  88       name = n;\line  89    \'7d\line  90    public String getSymbol()\line  91    \'7b\line  92       return symbol;\line  93    \'7d\line  94    public void setSymbol(String s)\line  95    \'7b\line  96       symbol = s;\line  97    \'7d\line  98    public double getQuantity()\line  99    \'7b\line 100       return quantity;\line 101    \'7d\line 102    public void setQuantity(double q)\line 103    \'7b\line 104       quantity = q;\line 105    \'7d\line 106    public double getCurrentPrice()\line 107    \'7b\line 108       return currentPrice;\line 109    \'7d\line 110    public void setCurrentPrice(double cp)\line 111    \'7b\line 112       currentPrice = cp;\line 113    \'7d\line 114    public double getAvgPrice()\line 115    \'7b\line 116       return avgPrice;\line 117    \'7d\line 118    public void setAvgPrice(double ap)\line 119    \'7b\line 120       avgPrice = ap;\line 121    \'7d\line 122    public double getBuyPrice()\line 123    \'7b\line 124       return buyPrice;\line 125    \'7d\line 126    public void setBuyPrice(double bp)\line 127    \'7b\line 128       buyPrice = bp;\line 129    \'7d\line 130    \line 131    public String toString()\line 132    \'7b\line 133       \line 134        return "Name: " +getName()+ ", Sym: " + getSymbol()+ ", Qty: " + getQuantity()+ ", CP: " + \line 135        getCurrentPrice()+ ", AP: " + getAvgPrice()+ ", BP: " + getBuyPrice()+ " \'5cn"; \line 136    \'7d\line 137 \line 138       \line 139 \'7d\line 140 \line 141 //!!STUDENT WILL MAKE THIS  <===\line 142 class NFT extends InvestmentProducts  \line 143 \'7b\line 144    //These are basic and call super to construct and overrides toString inclusively\line 145    public NFT(String n, String s, double q, double cp, double ap, double bp)    \line 146    \'7b\line 147       super(n,s,q,cp,ap,bp);\line 148    \'7d\line 149 \line 150 \'7d\line 151 \line 152 //!!STUDENT WILL MAKE THIS  <===\line 153 class Coins extends InvestmentProducts \line 154 \'7b\line 155   //These are basic and call super to construct and overrides toString inclusively\line 156    public Coins(String n, String s, double q, double cp, double ap, double bp)    \line 157    \'7b\line 158       super(n,s,q,cp,ap,bp);\line 159    \'7d\line 160     \line 161       \line 162 \'7d\line 163 \line 164 //!!STUDENT WILL MAKE THIS  <===\line 165 class Tokens extends InvestmentProducts \line 166 \'7b\line 167     \line 168    //These are basic and call super to construct and overrides toString inclusively \line 169    public Tokens(String n, String s, double q, double cp, double ap, double bp)    \line 170    \'7b\line 171       super(n,s,q,cp,ap,bp);\line 172    \'7d\line 173 \line 174 \'7d\line 175 \line 176 //Wrapper Class////////////////////////////////////////////////////////\line 177 //Uses a generic ArrayList for the three types of investment objects///\line 178 //!!STUDENT WILL MAKE THIS  <=====================================\line 179 class MyWrapper implements Wrapper_Interface\line 180 \'7b\line 181    //Generic ArrayList: for the given circumstances of this program\line 182    //it can store any object file type; this is one of many options\line 183    ArrayList arraylist = new ArrayList();\line 184    String temp = ""; //This instance variable will host all records for printing\line 185    \line 186    public MyWrapper()\line 187    \'7b\line 188       \line 189    \'7d\line 190    public void addToList(Object a)\line 191    \'7b\line 192       arraylist.add(a);\line 193    \'7d\line 194   //Test prints the objects to console\line 195   //Not Required method...just one of many ways   \line 196    public void wrapperPrinter(String s)\line 197    \'7b\line 198       System.out.print(s);\line 199    \'7d\line 200 \line 201    \line 202    //Builds single String object with delimieters and headers\line 203    //from generic structure. Called from fileTextReturn()\line 204    //Not Required...just one of many ways  \line 205    public void fileFeed()\line 206    \'7b\line 207       for(Object o : arraylist)\line 208       \'7b   \line 209          String temp2 = o.toString();\line 210          temp += temp2;      \line 211       \'7d\line 212       \line 213    \'7d\line 214    //Calls the functions that builds the String object and returns it\line 215    //Not Required\line 216    public String fileTextReturn()\line 217    \'7b\line 218       fileFeed();\line 219       return "\'5cn"+ temp; //instance String from above\line 220    \'7d\line 221 \line 222    ///////////////////////////////////////////////\line 223    //Writes to the PrintWriter file object by using the fileTextReturn and fileFeed methods.\line 224    //fileTextReturn and fileFeed methods are not reuired but this method MUST write to the file object\line 225    //Interface method\line 226    //!!STUDENT WILL MAKE THIS  <=====================================\line 227    public void fileWriter()\line 228    \'7b\line 229       PrintWriter out = openWriter("Portfolio.csv");\line 230       exportDate(out); //This creates a consistend format for console and file\line 231       String wraptemp = fileTextReturn();  //Not required method there's other solutions besideds this\line 232       wrapperPrinter(wraptemp); //Not required method there's other solutions besideds this\line 233       out.println(wraptemp); //This will have to happen to get the data to the file\line 234       out.close(); //It's okay if they forget to close; not part of the rubric\line 235    \'7d\line 236 \line 237     /////////////////////////////////////////////\line 238     //Prints the current date to console and to the file\line 239     //Interface method\line 240     //!!STUDENT WILL MAKE THIS  <=====================================\line 241    public void exportDate(PrintWriter out)\line 242    \'7b\line 243       java.util.Date date = new java.util.Date();  \line 244       //Console print\line 245       System.out.println("\'5cn****************************************");\line 246       System.out.println("****************************************");\line 247       System.out.println(date+"\'5cn****************************************");\line 248       //.csv file print\line 249       out.println("\'5cn****************************************");\line 250       out.println("****************************************");\line 251       out.println(date+"\'5cn****************************************");\'7d\line 252 \line 253    /////////////////////////////////////////////\line 254    //Creates the PrintWrite object file\line 255    //Interface method\line 256    //!!STUDENT WILL MAKE THIS  <=====================================  \line 257    public PrintWriter openWriter(String name)\line 258    \'7b\line 259       try\line 260       \'7b\line 261          File file = new File(name);\line 262          PrintWriter out =\line 263             new PrintWriter(\line 264                 new BufferedWriter(\line 265                     new FileWriter(file) ), true );\line 266          return out;\line 267       \'7d\line 268       catch (IOException e)\line 269       \'7b\line 270          System.out.println("I/O Error");\line 271          System.exit(0);\line 272       \'7d\line 273       return null;\line 274    \line 275    \'7d\line 276 \line 277 \'7d\line 278 \line 279 //File Input///////////////////////////////////////////////////////////\line 280 //!!STUDENT WILL MAKE THIS  <=====================================    \line 281 class RecordReader implements FileReader_Interface\line 282 \'7b\line 283    //These are not required\line 284    private BufferedReader in;  \line 285    MyWrapper wrp;\line 286    Object obj;\line 287   \line 288    //The constructor setup below is not required\line 289    //NOTE: this MyWrapper object is still through reference via Main()\line 290    public RecordReader(MyWrapper w, String r)\line 291    \'7b\line 292       wrp = w;\line 293       in = getReader(r);\line 294       obj = null;\line 295    \'7d\line 296    \line 297       \line 298    //!!STUDENT WILL MAKE THIS  <=====================================  \line 299    //This method is called from the object in the Main class\line 300    public void inputFileReader() \line 301    \'7b\line 302       obj = readBlock(in);  //old one was readCustomer\line 303       wrp.addToList(obj);\line 304       while ( obj != null) \line 305       \'7b\line 306          obj = readBlock(in);\line 307          if( obj != null)\line 308             wrp.addToList(obj);\line 309       \'7d\line 310    \line 311    \'7d\line 312               \line 313   ////////////////////////////////////////////// \line 314   //PARTIAL STUDENT AND GIVEN\line 315   \line 316   //GIVEN\line 317    public Object readBlock(BufferedReader in)   \line 318    \'7b\line 319        \line 320       String type ="";\line 321       String name ="";\line 322       String symbol ="";\line 323       double quantity;\line 324       double currentPrice;\line 325       double avgCost;\line 326       double buyPrice;\line 327       \line 328                \line 329       String line = "";\line 330       String[] data;  \line 331       \line 332       //catches errors in the read\line 333       try\line 334       \'7b\line 335          line = in.readLine();\line 336       \'7d\line 337       catch (IOException e)\line 338       \'7b\line 339          System.out.println("I/O Error");\line 340          System.exit(0);\line 341       \'7d\line 342       //terminates the file read once it gets to the end\line 343       if (line == null)\line 344          return null;\line 345       else\line 346       \'7b\line 347          //each field goes in escalating arithmetic sequence 0 to 6\line 348          data = line.split(";");\line 349          type = data[0];\line 350          name = data[1];    \line 351          symbol = data[2];\line 352          quantity = Double.parseDouble(data[3]);\line 353          currentPrice = Double.parseDouble(data[4]);\line 354          avgCost = Double.parseDouble(data[5]);\line 355          buyPrice = Double.parseDouble(data[6]);\line 356       \line 357          //NOTE: removed this from the following condition checsk "type.trim()," \line 358          //!!STUDENT WILL MAKE THIS  <=====================================\line 359 \line 360          type = type.trim();\line 361          //There's other ways to accomplish this\line 362          //Code will have to be inspected to see if they create specific objects\line 363          if(type.equals("C"))\line 364          \'7b\line 365             return new Coins(name.trim(), symbol.trim(), quantity, currentPrice, avgCost, buyPrice);\line 366          \'7d\line 367          else if(type.equals("T"))\line 368          \'7b\line 369             return new Tokens(name.trim(), symbol.trim(), quantity, currentPrice, avgCost, buyPrice);\line 370          \'7d\line 371          else\line 372          \'7b\line 373             return new NFT(name.trim(), symbol.trim(), quantity, currentPrice, avgCost, buyPrice);\line 374          \'7d\line 375       \line 376                \line 377       \'7d\line 378    \'7d\line 379 /////////////////////////////////////////////////////////\line 380 //GOOD LEAVE ALONE\line 381 //GIVEN\line 382    public BufferedReader getReader(String name) \line 383    \'7b\line 384       BufferedReader in = null;\line 385       try\line 386       \'7b\line 387          File file = new File(name);\line 388          in = new BufferedReader(\line 389                new FileReader(file) );\line 390       \'7d\line 391       catch (FileNotFoundException e)\line 392       \'7b\line 393          System.out.println(\line 394                "The file doesn't exist.");\line 395          System.exit(0);\line 396       \'7d\line 397       return in;\line 398    \'7d\line 399 \line 400 \'7d\line 401 \line 402 //////Interfaces///////////////////////////////////////////////////////\line 403 \line 404 //GIVEN   \line 405 interface Assett_Interface\line 406 \'7b\line 407    public String getType();\line 408    public void setType(String t);\line 409    public String getName();\line 410    public void setName(String n);\line 411    public String getSymbol();\line 412    public void setSymbol(String s);\line 413    public double getQuantity();\line 414    public void setQuantity(double q);\line 415    public double getCurrentPrice();\line 416    public void setCurrentPrice(double cp);\line 417    public double getAvgPrice();\line 418    public void setAvgPrice(double ap);\line 419    public double getBuyPrice();\line 420    public void setBuyPrice(double bp);\line 421    public String toString();\line 