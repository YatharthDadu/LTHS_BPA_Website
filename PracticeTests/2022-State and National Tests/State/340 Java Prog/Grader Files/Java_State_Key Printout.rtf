{\fs20\f1\cf0   1 import java.util.*;\line   2 import java.text.NumberFormat;\line   3 import java.io.*;\line   4 \line   5 //For State they will read the entire file and break it into the other objects\line   6 public class TollwayCustomerDataBaseState\line   7    \'7b\line   8 \line   9  \line  10    public static void main (String args [])\line  11       \'7b\line  12       \line  13    \line  14       BufferedReader in = getReader("Names.txt");  \line  15       List<Customer> customers = new ArrayList<>();  //Contains the customer objects\line  16       Customer cust = readCustomer(in);\line  17       customers.add(cust);\line  18       while (cust != null) \line  19          \'7b\line  20          cust = readCustomer(in);\line  21          if(cust != null)\line  22             customers.add(cust);\line  23          \'7d\line  24       System.out.println(">>>>>>>>>>>>> There were " + customers.size()+ " created.<<<<<<<<<<<\'5cn");\line  25       for (Customer c : customers)\'7b\line  26          System.out.println(c.getInfo()); \line  27          \'7d\line  28    \line  29       \line  30       \'7d\line  31       \line  32    //Reads the information from the file and breaks it into each of the objects that go into the Customer object            \line  33    private static Customer readCustomer(BufferedReader in)  \line  34       \'7b\line  35       //Name Class plus Fields\line  36       Name name; String firstN; String lastN;\line  37       //CarInfo Class plus Fields\line  38       CarInfo carinfo; String make; String model; String plates;\line  39       //Payment Class plus Fields\line  40       Payment payment;double deposit; String creditcard;\line  41       String line = "";\line  42       String[] data;  \line  43       \line  44       //catches errors in the read\line  45       try\line  46          \'7b\line  47          line = in.readLine();\line  48          \'7d\line  49       catch (IOException e)\line  50          \'7b\line  51          System.out.println("I/O Error");\line  52          System.exit(0);\line  53          \'7d\line  54       //ends the read once it gets to the end\line  55       if (line == null)\line  56          return null;\line  57       else\line  58          \'7b\line  59          data = line.split(",");  //"," is the delimeter to seperate the fields for the records\line  60          firstN = data[0];    //each field goes in escalating arithmetic sequence 0 to 6\line  61          lastN = data[1];\line  62          make = data[2];\line  63          model = data[3];\line  64          plates = data[4];\line  65          deposit = Double.parseDouble(data[5]);\line  66          creditcard = data[6];\line  67          //construct the objects to be placed in the Customer object\line  68          name = new Name(firstN, lastN);\line  69          carinfo = new CarInfo(make, model, plates);\line  70          payment = new Payment(deposit, creditcard);\line  71          return new Customer(name, carinfo, payment);\line  72          \'7d\line  73       \'7d\line  74    \line  75    //imports the file properly for BufferedReader\line  76    private static BufferedReader getReader(String name)  \line  77       \'7b\line  78       BufferedReader in = null;\line  79       try\line  80          \'7b\line  81          File file = new File(name);\line  82          in = new BufferedReader(\line  83             new FileReader(file) );\line  84          \'7d\line  85       catch (FileNotFoundException e)\line  86          \'7b\line  87          System.out.println(\line  88             "The file doesn't exist.");\line  89          System.exit(0);\line  90          \'7d\line  91       return in;\line  92       \'7d\line  93    \'7d\line  94    \line  95 \line  96 //////State Customer Information\line  97 class Customer\line  98    \'7b\line  99    public Name name;\line 100    public CarInfo carinfo;\line 101    public Payment pay;\line 102    \line 103    public Customer(Name n, CarInfo c, Payment p)    \line 104       \'7b\line 105       this.name = n;\line 106       this.carinfo = c;\line 107       this.pay = p;\line 108       \'7d\line 109    \line 110    public String getInfo()\'7b\line 111    \line 112       return this.name.getInfo() + "\'5cn" + this.carinfo.getInfo() + "\'5cn" + this.pay.getInfo() + "\'5cn" ;\line 113       \'7d\line 114    \'7d\line 115 \line 116 class Name\line 117    \'7b\line 118    private String last_Name;\line 119    private String first_Name;\line 120    \line 121    public Name(String fn, String ln)\line 122       \'7b\line 123       this.last_Name = ln;\line 124       this.first_Name = fn;\line 125       \'7d\line 126    \line 127    public String getInfo()\line 128       \'7b\line 129       return "Name: " + this.first_Name + " " + this.last_Name;\line 130       \'7d     \line 131 \line 132    \'7d\line 133 \line 134 class CarInfo\line 135    \'7b\line 136    private String make;\line 137    private String model;\line 138    private String plates;\line 139    \line 140    public CarInfo(String ma, String mo, String pl)\line 141       \'7b\line 142       this.make = ma;\line 143       this.model = mo;\line 144       this.plates = pl;\line 145       \'7d\line 146    \line 147    public String getInfo()\line 148       \'7b\line 149       return "Car Information: " + this.make + " " + this.model + " " + this.plates ;\line 150       \'7d     \line 151 \line 152    \'7d\line 153 \line 154 class Payment\line 155    \'7b\line 156    private double deposit;\line 157    private String creditCard;\line 158    private NumberFormat depositFormat = NumberFormat.getCurrencyInstance();   \line 159    public Payment(double de, String cc)\line 160       \'7b\line 161       this.deposit = de;\line 162       this.creditCard = cc;\line 163       \'7d\line 164       \line 165    public String getInfo()\line 166       \'7b\line 167       return "Payment: " + depositFormat.format(this.deposit) + " " + this.creditCard;\line 168       \'7d     \line 169       \line 170    public double getDeposit()\'7b         \line 171       return this.deposit; \'7d\line 172    \line 173    \'7d\line 174 \line 175 }}