{\fs20\f1\cf0   1 import java.util.*;\line   2 import java.text.NumberFormat;\line   3 import java.io.*;\line   4 \line   5 //For State they will read the entire file and break it into the other objects\line   6 public class TollwayCustomerDataBaseNational\line   7    \'7b\line   8 \line   9  \line  10    public static void main (String args [])\line  11       \'7b\line  12       \line  13       \line  14       BufferedReader in = getReader("Names.txt");  \line  15       List<Customer> customers = new ArrayList<>();  //Contains the customer objects\line  16       List<Customer> clonedCustomers = new ArrayList<>(); \line  17       Customer cust = readCustomer(in);\line  18       customers.add(cust);\line  19       while (cust != null) \line  20          \'7b\line  21          cust = readCustomer(in);\line  22          if(cust != null)\line  23             customers.add(cust);\line  24          \'7d\line  25       for (Customer c : customers)\'7b\line  26          System.out.println(c);\line  27          System.out.println(c.getInfo());\line  28          clonedCustomers.add((Customer)c.clone());\line  29          \'7d\line  30       System.out.println("*******************CLONES*******************");\line  31       for (Customer c : clonedCustomers)\'7b\line  32          System.out.println(c);\line  33          System.out.println(c.getInfo());\line  34          \'7d\line  35            \line  36       //This block will export the data to the text file. \line  37       PrintWriter out = openWriter("Clones.txt");\line  38       exportDate(out);\line  39       for (Customer c : clonedCustomers)\line  40               exportClones(c, out);\line  41       out.close();   \line  42       \'7d\line  43  \line  44   //These two methods write to the file. exportDate prints the current date at the top\line  45    private static void exportDate(PrintWriter out)\line  46       \'7b\line  47       java.util.Date date = new java.util.Date();  \line  48       out.println(date);\line  49       \'7d\line  50   \line  51   //exportClones prints each cloned Customer record to the text file   \line  52    private static void exportClones(Customer c,    \line  53        PrintWriter out)\line  54       \'7b\line  55       String line = c.getInfo();\line  56       out.println(line);\line  57       \'7d\line  58   \line  59   //Creates the proper file for the text to be written to\line  60    private static PrintWriter openWriter(String name)\line  61       \'7b\line  62       try\line  63          \'7b\line  64          File file = new File(name);\line  65          PrintWriter out =\line  66             new PrintWriter(\line  67                 new BufferedWriter(\line  68                     new FileWriter(file) ), true );\line  69          return out;\line  70          \'7d\line  71       catch (IOException e)\line  72          \'7b\line  73          System.out.println("I/O Error");\line  74          System.exit(0);\line  75          \'7d\line  76       return null;\line  77       \'7d\line  78     \line  79 \line  80 //Reads the information from the file and breaks it into each of the objects that go into the Customer object            \line  81    private static Customer readCustomer(BufferedReader in)  \line  82       \'7b\line  83       //Name Class plus Fields\line  84       Name name; String firstN; String lastN;\line  85       //CarInfo Class plus Fields\line  86       CarInfo carinfo; String make; String model; String plates;\line  87       //Payment Class plus Fields\line  88       Payment payment;double deposit; String creditcard;\line  89       String line = "";\line  90       String[] data;  \line  91       \line  92       //catches errors in the read\line  93       try\line  94          \'7b\line  95          line = in.readLine();\line  96          \'7d\line  97       catch (IOException e)\line  98          \'7b\line  99          System.out.println("I/O Error");\line 100          System.exit(0);\line 101          \'7d\line 102       //ends the read once it gets to the end\line 103       if (line == null)\line 104          return null;\line 105       else\line 106          \'7b\line 107          data = line.split(",");  //"," is the delimeter to seperate the fields for the records\line 108          firstN = data[0];    //each field goes in escalating arithmetic sequence 0 to 6\line 109          lastN = data[1];\line 110          make = data[2];\line 111          model = data[3];\line 112          plates = data[4];\line 113          deposit = Double.parseDouble(data[5]);\line 114          creditcard = data[6];\line 115          //construct the objects to be placed in the Customer object\line 116          name = new Name(firstN, lastN);\line 117          carinfo = new CarInfo(make, model, plates);\line 118          payment = new Payment(deposit, creditcard);\line 119          return new Customer(name, carinfo, payment);\line 120          \'7d\line 121       \'7d\line 122    \line 123    \line 124 \line 125 //imports the file properly for BufferedReader\line 126    private static BufferedReader getReader(String name)  \line 127       \'7b\line 128       BufferedReader in = null;\line 129       try\line 130          \'7b\line 131          File file = new File(name);\line 132          in = new BufferedReader(\line 133             new FileReader(file) );\line 134          \'7d\line 135       catch (FileNotFoundException e)\line 136          \'7b\line 137          System.out.println(\line 138             "The file doesn't exist.");\line 139          System.exit(0);\line 140          \'7d\line 141       return in;\line 142       \'7d\line 143    \'7d\line 144 \line 145 //////////HELPER CLASSES////////////////////////////////////////////////////////////\line 146 /*  The four helper classes are basically the same layout excluding the differences\line 147 *   which are in their fields of data. Each one must use the interfaces. \line 148 */\line 149 \line 150 //////Customer Objects Information/////////////////////////////////////\line 151 class Customer implements InformationRetrieval, Cloneable\line 152    \'7b\line 153    public Name name;\line 154    public CarInfo carinfo;\line 155    public Payment pay;\line 156    private String cloned ="";  //this is just a flag to help quickly identify if the record was cloned\line 157    \line 158    public Customer(Name n, CarInfo c, Payment p)    \line 159       \'7b\line 160       this.name = n;\line 161       this.carinfo = c;\line 162       this.pay = p;\line 163       \'7d\line 164    \line 165    //Required method from the interface\line 166    public String getInfo()\line 167       \'7b\line 168    \line 169       return  cloned + this.name.getInfo() + "\'5cn" + this.carinfo.getInfo() + "\'5cn" + this.pay.getInfo() + "\'5cn" ;\line 170       \'7d\line 171    \line 172    //Required method from the interface\line 173    public Object clone()\line 174       \'7b\line 175       Customer customer;\line 176       try\line 177          \'7b\line 178          cloned = confirmed();\line 179          customer = (Customer) super.clone();\line 180          customer.name = (Name)name.clone();\line 181          customer.carinfo = (CarInfo)carinfo.clone();\line 182          customer.pay = (Payment)pay.clone();\line 183          \'7d\line 184       catch (CloneNotSupportedException e)\line 185          \'7b\line 186          return null;  \line 187          \'7d\line 188       return customer;\line 189       \'7d\line 190    // This method only supplies the cloned variable with a string literal. It is only called in the clone() method   \line 191    public String confirmed()\line 192       \'7b\line 193       return "DUPLICATES \'5cn";\line 194       \'7d;  \line 195    \'7d\line 196 \line 197 //////Name Object Information/////////////////////////////////////\line 198 class Name implements InformationRetrieval, Cloneable\line 199    \'7b\line 200    private String last_Name;\line 201    private String first_Name;\line 202    private String cloned ="";\line 203    \line 204    public Name(String fn, String ln)\line 205       \'7b\line 206       this.last_Name = ln;\line 207       this.first_Name = fn;\line 208       \'7d\line 209    \line 210    public String getInfo()\line 211       \'7b\line 212       return cloned + " Name: " + this.first_Name + " " + this.last_Name;\line 213       \'7d     \line 214    public Object clone()\line 215       \'7b\line 216       try\line 217          \'7b\line 218          cloned = confirmed();\line 219          return super.clone();\line 220       \line 221          \'7d\line 222       catch (CloneNotSupportedException e)\line 223          \'7b\line 224          return null;  \line 225          \'7d\line 226    \line 227       \'7d\line 228    public String confirmed()\line 229       \'7b\line 230       return "CLONED";\line 231       \'7d; \line 232 \line 233    \'7d\line 234 \line 235 //////CarInfo Object Information/////////////////////////////////////\line 236 class CarInfo implements InformationRetrieval, Cloneable\line 237    \'7b\line 238    private String make;\line 239    private String model;\line 240    private String plates;\line 241    private String cloned ="";\line 242    \line 243    public CarInfo(String ma, String mo, String pl)\line 244       \'7b\line 245       this.make = ma;\line 246       this.model = mo;\line 247       this.plates = pl;\line 248       \'7d\line 249    \line 250    public String getInfo()\line 251       \'7b\line 252       return cloned + " Car Information: " + this.make + " " + this.model + " " + this.plates ;\line 253       \'7d     \line 254    public Object clone()\line 255       \'7b\line 256       try\line 257          \'7b\line 258          cloned = confirmed();\line 259          return super.clone();\line 260          \line 261          \'7d\line 262       catch (CloneNotSupportedException e)\line 263          \'7b\line 264          return null;  \line 265          \'7d\line 266       \line 267       \'7d\line 268    public String confirmed()\line 269       \'7b\line 270       return "CLONED";\line 271       \'7d; \line 272    \'7d\line 273 \line 274 //////Payment Object Information/////////////////////////////////////\line 275 class Payment implements InformationRetrieval, Cloneable\line 276    \'7b\line 277    private double deposit;\line 278    private String creditCard;\line 279    private NumberFormat depositFormat = NumberFormat.getCurrencyInstance();  \line 280    private String cloned ="";\line 281     \line 282    public Payment(double de, String cc)\line 283       \'7b\line 284       this.deposit = de;\line 285       this.creditCard = cc;\line 286       \'7d\line 287       \line 288    public String getInfo()\line 289       \'7b\line 290       return cloned + " Payment: " + depositFormat.format(this.deposit) + " " + this.creditCard;\line 291       \'7d     \line 292       \line 293    public Object clone()\line 294       \'7b\line 295       try\line 296          \'7b\line 297          cloned = confirmed();\line 298          return super.clone();\line 299       \line 300          \'7d\line 301       catch (CloneNotSupportedException e)\line 302          \'7b\line 303          return null;  \line 304          \'7d\line 305    \line 306       \'7d\line 307       \line 308    public String confirmed()\line 309       \'7b\line 310       return "CLONED";\line 311       \'7d; \line 312    \'7d\line 313    \line 314 //////InformationRetrieval Interface/////////////////////////////////////\line 315 interface InformationRetrieval\line 316    \'7b\line 317    public String getInfo();  //this returns the strings for printing to the console and to write the file\line 318    public String confirmed();   //returns a string to fill an empty String object to append the word CLONED to each line of\line 319                                 //data that is printed.  \line 320    \line 321    \'7d}}