    "450": {
        "id": "450",
        "title": "PODCAST PRODUCTION TEAM",
        "description": "The team will research and create a three to five (3:00-5:00) minute podcast based on the assigned topic. Core competencies assessed include, but are not limited to, Apply audience analysis and design principles & elements to research and develop discussion points, outlines, and scripts, ensuring clear messaging and engagement for a defined target audience across platforms; Develop and edit professional lead-in and lead-out segways and implement audio editing and splicing workflows using industry-standard software, incorporating nonlinear editing, mixing, and effects to enhance storytelling and production value.",
        "wsapLink": "#",
        "practiceTests": [{"name": "450_N_Podcast Production Team Presentation Rubric_2024.pdf", "url": "PracticeTests\\2024-State and National Tests\\2024 National Tests\\400s DIGITAL COMMUNICATION & DESIGN\\450-Podcast Production Team\\450_N_Podcast Production Team Presentation Rubric_2024.pdf"}, {"name": "450_N_Podcast Production Technical Rubric 2024.pdf", "url": "PracticeTests\\2024-State and National Tests\\2024 National Tests\\400s DIGITAL COMMUNICATION & DESIGN\\450-Podcast Production Team\\450_N_Podcast Production Technical Rubric 2024.pdf"}, {"name": "450_Podcast  Production Team Technical_Rubric_2022.pdf", "url": "PracticeTests\\2022-State and National Tests\\National\\435 Website Design Team\\450 Podcast Production Team\\450_Podcast  Production Team Technical_Rubric_2022.pdf"}, {"name": "450_Podcast  Production Team Technical_Rubric_2022.pdf", "url": "PracticeTests\\2022-State and National Tests\\National\\450 Podcast Production Team\\450_Podcast  Production Team Technical_Rubric_2022.pdf"}, {"name": "450_Podcast  Production Team Technical_Rubric_R_2023.pdf", "url": "PracticeTests\\2023-State and National Tests\\2023 State\\400s\\450_Podcast  Production Team Technical_Rubric_R_2023.pdf"}, {"name": "450_Podcast  Production Team_Technical Rubric_2021.pdf", "url": "PracticeTests\\2021 SPS - State - National\\STATE 2021\\400_s Digital Communication & Design\\(450) Podcast Production Team\\pdf\\450_Podcast  Production Team_Technical Rubric_2021.pdf"}, {"name": "450_Podcast Production Team Presentation_Rubric_2022.pdf", "url": "PracticeTests\\2022-State and National Tests\\National\\435 Website Design Team\\450 Podcast Production Team\\450_Podcast Production Team Presentation_Rubric_2022.pdf"}, {"name": "450_Podcast Production Team Presentation_Rubric_2022.pdf", "url": "PracticeTests\\2022-State and National Tests\\National\\450 Podcast Production Team\\450_Podcast Production Team Presentation_Rubric_2022.pdf"}, {"name": "450_Podcast Production Team Presentati