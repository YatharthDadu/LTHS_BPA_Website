    "460": {
        "id": "460",
        "title": "VISUAL DESIGN TEAM",
        "description": "The team will use UX and UI design to develop mockups that are visually and functionally aligned with the assigned topic. Core competencies assessed include, but are not limited to, Integrate color theory, typography, and design principles & elements \u2014 including hierarchy, spacing, and grid systems \u2014 to create visually compelling, readable, and brand-consistent designs across digital and print media; Apply audience analysis and user-centered design principles & elements to develop and present design concepts persuasively, using visual storytelling and data-driven rationale to support thematic choices and engagement for a defined target audience.",
        "wsapLink": "#",
        "practiceTests": [{"name": "460_N_Visual Design Team Presentation Rubric_2024.pdf", "url": "PracticeTests\\2024-State and National Tests\\2024 National Tests\\400s DIGITAL COMMUNICATION & DESIGN\\460-Visual Design Team\\460_N_Visual Design Team Presentation Rubric_2024.pdf"}, {"name": "460_N_Visual Design Team Technical Rubric 2024.pdf", "url": "PracticeTests\\2024-State and National Tests\\2024 National Tests\\400s DIGITAL COMMUNICATION & DESIGN\\460-Visual Design Team\\460_N_Visual Design Team Technical Rubric 2024.pdf"}, {"name": "460_S_Visual Design Team Presentation Rubric_2024.pdf", "url": "PracticeTests\\2024-State and National Tests\\2024 State Tests\\400_s DIGITAL COMMUNICATION & DESIGN\\460 Visual Design Team - Pilot\\460_S_Visual Design Team Presentation Rubric_2024.pdf"}, {"name": "460_S_Visual Design Team Technical Rubric 2024.pdf", "url": "PracticeTests\\2024-State and National Tests\\2024 State Tests\\400_s DIGITAL COMMUNICATION & DESIGN\\460 Visual Design Team - Pilot\\460_S_Visual Design Team Technical Rubric 2024.pdf"}, {"name": "460_Visual Design Team_Presentation Rubric_R_2023_Pilot.pdf", "url": "PracticeTests\\2023-State and National Tests\\2023 State\\400s\\460_Visual Design Team_Presentation Rubric_R_2023_Pilot.pdf"}, {"name": "460_Visual Design Team_S_2023 Key_Pilot.pdf", "url": "PracticeTests\\2023-State and National Tests\\2023 State\\400s\\460_Visual Design Team_S_2023 Key_Pilot.pdf"}, {"name": "460_Visual Design Team_Technical Rubric _R_2023_Pilot.pdf", "url": "PracticeTests\\2023-State and National Tests\\2023 State\\400s\\460_Visual Design Team_Technical Rubric _R_2023_Pilot.pdf"}],
