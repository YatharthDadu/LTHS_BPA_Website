    "455": {
        "id": "455",
        "title": "USER EXPERIENCE DESIGN TEAM",
        "description": "The team will prototype digital experiences for a single brand based on the assigned topic, emphasizing collaboration, user experience design, and design rationale. Core competencies assessed include, but are not limited to, Develop and implement integrated design strategies that maintain consistent branding and visual style across digital, print, and interactive media platforms, employing advanced design principles & elements and layout techniques \u2014 including grid systems, hier archy, and whitespace \u2014 for readability and accessibility; Apply audience analysis and user-centered design principles & elements while incorporating accessibility standards (WCAG) and responsive design techniques to create content that is relevant, engaging, and usable for all audiences across devices.",
        "wsapLink": "#",
        "practiceTests": [{"name": "455_N_User Experience Design Team Presentation Rubric_2024.pdf", "url": "PracticeTests\\2024-State and National Tests\\2024 National Tests\\400s DIGITAL COMMUNICATION & DESIGN\\455-User Experience Design Team\\455_N_User Experience Design Team Presentation Rubric_2024.pdf"}, {"name": "455_N_User Experience Design Team Technical Rubric 2024.pdf", "url": "PracticeTests\\2024-State and National Tests\\2024 National Tests\\400s DIGITAL COMMUNICATION & DESIGN\\455-User Experience Design Team\\455_N_User Experience Design Team Technical Rubric 2024.pdf"}, {"name": "455_S_User Experience Design Team Presentation Rubric_2024.pdf", "url": "PracticeTests\\2024-State and National Tests\\2024 State Tests\\400_s DIGITAL COMMUNICATION & DESIGN\\455 User Experience Design Team\\455_S_User Experience Design Team Presentation Rubric_2024.pdf"}, {"name": "455_S_User Experience Design Team Technical Rubric 2024.pdf", "url": "PracticeTests\\2024-State and National Tests\\2024 State Tests\\400_s DIGITAL COMMUNICATION & DESIGN\\455 User Experience Design Team\\455_S_User Experience Design Team Technical Rubric 2024.pdf"}, {"name": "455_User Experience Design Team Using Adobe XD_N_2022 Key_Pilot.pdf", "url": "PracticeTests\\2022-State and National Tests\\National\\455 User Experience Design Team\\455_User Experience Design Team Using Adobe XD_N_2022 Key_Pilot.pdf"}, {"name": "455_User Experience Design Team Using Adobe XD_N_2022 Key_Pilot.pdf", "url": "PracticeTests\\2022-State and National Tests\\National\\510 Small Business Management Team\\455 User Experience Design Team\\455_User Experience Design Team Using Adobe XD_N_2022 Key_Pilot.pdf"}, {"name": "455_User Experience Design Team using Adobe XD_Presentation Rubric_2022_Pilot.pdf", "url": "PracticeTests\\2022-State and National Tests\\National\\455 User Experience Design Team\\455_User Experience Design Team using Adobe XD_Presentation Rubric_2022_Pilot.pdf"}, {"name": "455_User Experience Design T