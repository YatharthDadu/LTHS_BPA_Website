    "430": {
        "id": "430",
        "title": "VIDEO PRODUCTION TEAM",
        "description": "Contestants will create a three to five (3:00-5:00) minute video production, based on the provided topic. Core competencies assessed include, but are not limited to, Apply audience analysis and user-centered design principles & elements to create and refine storylines using digital storyboarding and scripting, ensuring clear messaging and engagement for a defined target audience across web, social, and mobile platforms; Utilize video production software, hardware, and workflows to plan, capture, and edit high-quality video content, incorporating nonlinear editing techniques, transitions, audio mixing, sound design, titles, and visual effects to enhance storytelling and pr oduction value.",
        "wsapLink": "#",
