    "410": {
        "id": "410",
        "title": "GRAPHIC DESIGN PROMOTION",
        "description": "Contestants will receive a themed event and be required to design a logo, tagline, and brand identity, incorporating these elements into a variety of promotional materials. Core competencies assessed include, but are not limited to, Apply foundational graphic design principles \u2014 including layout, composition, color theory, typography, and visual hierarchy \u2014 to create cohesive, accessible, and visually compelling designs for print and digital media; Develop, articulate, and present creative concepts and original artwork that visually communicate themes, messages, and brand identity to clients and stakeholders using professional communication, and digital presentation tools.",
        "wsapLink": "#",
